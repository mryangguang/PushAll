{
  "type": "object",
  "properties": {
    "webhook": {
      "type": "string",
      "title": "Webhook 地址",
      "description": "钉钉群 → 群设置 → 智能群助手 → 添加机器人 → 自定义 → 复制 Webhook",
      "x-ui": {"widget": "text", "secret": true, "placeholder": "https://oapi.dingtalk.com/robot/send?access_token=..."}
    },
    "secret": {
      "type": "string",
      "title": "加签密钥",
      "description": "安全设置选择「加签」时填写（SEC 开头）；选择「自定义关键词」可留空",
      "x-ui": {"widget": "password", "secret": true}
    },
    "at_mobiles": {
      "type": "string",
      "title": "@ 手机号",
      "description": "多个用英文逗号分隔",
      "x-ui": {"widget": "text", "placeholder": "13800000000,13900000000"}
    },
    "at_all": {"type": "boolean", "title": "@ 所有人", "default": false}
  },
  "required": ["webhook"]
}
