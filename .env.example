# 时区，影响 cron 触发与日志时间
PUSHALL_TZ=Asia/Shanghai
# 数据目录（默认 ./data），存放 SQLite 库
# PUSHALL_DATA_DIR=D:\PushAll\data
# 用户插件目录（默认 ./plugins）
# PUSHALL_PLUGIN_DIR=D:\PushAll\plugins
# 日志保留天数
PUSHALL_LOG_KEEP_DAYS=90
# 单次查询最大行数
PUSHALL_MAX_ROWS=500
# 内置 HTTP 默认超时（秒）
PUSHALL_HTTP_TIMEOUT=20
# 管理接口令牌；为空表示不校验（仅建议本机使用）
# PUSHALL_TOKEN=
# 用于加密库内 webhook/password 等敏感字段；一旦设置请勿随意更换
# PUSHALL_SECRET_KEY=
